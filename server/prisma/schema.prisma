generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

 profile             Profile?
createdProjects     Project[]            @relation("CreatedProjects")
teamMemberships     TeamMember[]
sentInvitations     ProjectInvitation[] @relation("SentInvitations")
receivedInvitations ProjectInvitation[] @relation("ReceivedInvitations")
}

model Profile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique

  bio          String?
  college      String?
  course       String?
  year         Int?
  skills       String?
  interests    String?
  availability String?
  experience   String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  teamSize    Int
  duration    String

  creatorId   Int
  creator     User     @relation("CreatedProjects", fields: [creatorId], references: [id], onDelete: Cascade)

  roles       ProjectRole[]
members     TeamMember[]
tasks       Task[]
invitations  ProjectInvitation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectRole {
  id        Int     @id @default(autoincrement())
  projectId Int
  role      String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  role      String
  status    String   @default("active")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectInvitation {
  id          Int      @id @default(autoincrement())

  projectId   Int
  senderId    Int
  receiverId  Int

  role        String
  status      String   @default("pending")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, receiverId, role])
}

model Task {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  status      String   @default("TODO")
  assigneeId  Int?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Opportunity {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  type         String
  organization String
  deadline     DateTime?
  link         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}